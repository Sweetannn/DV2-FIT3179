{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 650,
  "height": 380,
  "padding": {
    "top": 50,
    "bottom": 50,
    "left": 12,
    "right": 275
  },
  "autosize": "pad",
  "signals": [
    {
      "name": "radius",
      "value": 180
    },
    {
      "name": "cx",
      "update": "width / 2"
    },
    {
      "name": "cy",
      "update": "height / 2"
    }
  ],
  "data": [
    {
      "name": "nodes",
      "url": "data/final/06_network_nodes.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "indexof(['Darwin', 'Brisbane', 'Sydney', 'Canberra–Queanbeyan', 'Hobart', 'Melbourne', 'Adelaide', 'Perth'], datum.city)",
          "as": "geo_rank"
        },
        {
          "type": "formula",
          "expr": "datum.geo_rank * 2 * PI / 8 - PI/2",
          "as": "angle"
        },
        {
          "type": "formula",
          "expr": "cx + cos(datum.angle) * radius",
          "as": "x"
        },
        {
          "type": "formula",
          "expr": "cy + sin(datum.angle) * radius",
          "as": "y"
        },
        {
          "type": "formula",
          "expr": "cos(datum.angle) > 0.01 ? 'left' : (cos(datum.angle) < -0.01 ? 'right' : 'center')",
          "as": "labelAlign"
        },
        {
          "type": "formula",
          "expr": "sin(datum.angle) > 0.01 ? 'top' : (sin(datum.angle) < -0.01 ? 'bottom' : 'middle')",
          "as": "labelBaseline"
        }
      ]
    },
    {
      "name": "edges",
      "url": "data/final/07_network_edges.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "lookup",
          "from": "nodes",
          "key": "city",
          "fields": ["source", "target"],
          "as": ["s", "t"]
        },
        {
          "type": "filter",
          "expr": "datum.s != null && datum.t != null"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "nodeSize",
      "type": "linear",
      "domain": {
        "data": "nodes",
        "field": "species_richness"
      },
      "range": [200, 3500]
    },
    {
      "name": "edgeWidth",
      "type": "linear",
      "domain": {
        "data": "edges",
        "field": "shared_species"
      },
      "range": [0.5, 12]
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Brisbane",
        "Sydney",
        "Melbourne",
        "Canberra–Queanbeyan",
        "Adelaide",
        "Perth",
        "Hobart",
        "Darwin"
      ],
      "range": [
        "#B52F18",
        "#FFB430",
        "#47CAE6",
        "#1E7487",
        "#472801",
        "#122170",
        "#FD5DD8",
        "#CC025A"
      ]
    }
  ],
  "legends": [
    {
      "size": "nodeSize",
      "type": "symbol",
      "title": "City richness (species)",
      "orient": "none",
      "direction": "vertical",
      "tickCount": 3,
      "format": ",.0f",
      "symbolType": "circle",
      "symbolFillColor": "#67746D",
      "symbolStrokeColor": "#FFFFFF",
      "symbolStrokeWidth": 1,
      "titleFont": "Source Sans 3",
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "titleColor": "#202622",
      "labelFont": "Source Sans 3",
      "labelFontSize": 12,
      "labelColor": "#202622",
      "labelOffset": 8,
      "rowPadding": 3,
      "legendX": 690,
      "legendY": 30,
      "titleLimit": 230
    },
    {
      "strokeWidth": "edgeWidth",
      "type": "symbol",
      "title": "Shared species (city pairs)",
      "orient": "none",
      "direction": "vertical",
      "tickCount": 3,
      "format": ",.0f",
      "symbolType": "stroke",
      "symbolSize": 900,
      "symbolStrokeColor": "#68706A",
      "symbolOpacity": 0.9,
      "titleFont": "Source Sans 3",
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "titleColor": "#202622",
      "labelFont": "Source Sans 3",
      "labelFontSize": 12,
      "labelColor": "#202622",
      "labelOffset": 8,
      "rowPadding": 10,
      "legendX": 690,
      "legendY": 225,
      "titleLimit": 230
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "edges"
      },
      "encode": {
        "enter": {
          "strokeWidth": {
            "scale": "edgeWidth",
            "field": "shared_species"
          },
          "tooltip": {
            "signal": "{'Connected cities': datum.source + ' & ' + datum.target, 'Shared recorded species': format(datum.shared_species, ','), 'Period': '2016–2025'}"
          }
        },
        "update": {
          "path": {
            "signal": "'M' + datum.s.x + ',' + datum.s.y + ' L' + datum.t.x + ',' + datum.t.y"
          },
          "stroke": {
            "value": "#68706A"
          },
          "strokeOpacity": {
            "value": 0.25
          }
        },
        "hover": {
          "strokeOpacity": {
            "value": 0.9
          },
          "stroke": {
            "value": "#000000"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "color",
            "field": "city"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 2
          },
          "tooltip": {
            "signal": "{'Urban area': datum.city, 'Recorded species richness': format(datum.species_richness, ','), 'Period': '2016–2025'}"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "scale": "nodeSize",
            "field": "species_richness"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "text": {
            "field": "city"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#202622"
          }
        },
        "update": {
          "x": {
            "signal": "cx + cos(datum.angle) * (radius + sqrt(scale('nodeSize', datum.species_richness))/2 + 10)"
          },
          "y": {
            "signal": "cy + sin(datum.angle) * (radius + sqrt(scale('nodeSize', datum.species_richness))/2 + 10)"
          },
          "align": {
            "field": "labelAlign"
          },
          "baseline": {
            "field": "labelBaseline"
          }
        }
      }
    }
  ]
}
