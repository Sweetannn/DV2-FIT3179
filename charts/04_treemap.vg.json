{
  "$schema": "https://vega.github.io/schema/vega/v5.json",

  "width": 1100,
  "height": 700,

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "padding": 0,

  "signals": [
    {
      "name": "panelGapX",
      "value": 28
    },
    {
      "name": "panelGapY",
      "value": 34
    },
    {
      "name": "headerHeight",
      "value": 44
    },
    {
      "name": "panelWidth",
      "update": "(width - panelGapX) / 2"
    },
    {
      "name": "panelHeight",
      "update": "(height - panelGapY) / 2"
    },
    {
      "name": "treemapHeight",
      "update": "panelHeight - headerHeight"
    }
  ],

  "data": [
    {
      "name": "birdTree",

      "url": "data/final/treemap_panels/bird_treemap.csv",

      "format": {
        "type": "csv",
        "parse": {
          "species_richness": "number",
          "record_count": "number"
        }
      },

      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "species_richness",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "ratio": 1.2,
          "round": true,
          "paddingInner": 3,
          "size": [
            {
              "signal": "panelWidth"
            },
            {
              "signal": "treemapHeight"
            }
          ]
        }
      ]
    },

    {
      "name": "birdLeaves",

      "source": "birdTree",

      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },

    {
      "name": "mammalTree",

      "url": "data/final/treemap_panels/mammal_treemap.csv",

      "format": {
