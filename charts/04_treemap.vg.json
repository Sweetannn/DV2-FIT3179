  "marks": [
    {
      "type": "group",

      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "panelWidth"
          },
          "height": {
            "signal": "panelHeight"
          }
        }
      },

      "marks": [
        {
          "type": "text",

          "encode": {
            "enter": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 0
              },
              "text": {
                "value": "BIRD"
              },
              "font": {
                "value": "Source Sans 3"
              },
              "fontSize": {
                "value": 15
              },
              "fontWeight": {
                "value": 700
              },
              "fill": {
                "value": "#3978A8"
              },
              "baseline": {
                "value": "top"
              }
            }
          }
        },

        {
          "type": "text",

          "encode": {
            "enter": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 20
              },
              "text": {
                "value": "Recorded family richness: 660"
              },
              "font": {
                "value": "Source Sans 3"
              },
              "fontSize": {
                "value": 11.5
              },
              "fill": {
                "value": "#68706A"
              },
              "baseline": {
                "value": "top"
              }
            }
          }
        },

        {
          "type": "rect",

          "from": {
            "data": "birdLeaves"
          },

          "encode": {
            "enter": {
              "x": {
                "field": "x0"
              },
              "y": {
                "signal": "datum.y0 + headerHeight"
              },
              "x2": {
                "field": "x1"
              },
              "y2": {
                "signal": "datum.y1 + headerHeight"
              },

              "fill": {
                "signal": "datum.family_type === 'Other' ? '#A9C9DD' : '#3978A8'"
              },

              "stroke": {
                "value": "#FFFFFF"
              },

              "strokeWidth": {
                "value": 2
              },

              "tooltip": {
                "signal": "{'Family': datum.family, 'Recorded species richness': format(datum.species_richness, ','), 'Occurrence records': format(datum.record_count, ',')}"
              }
            },

            "update": {
              "fillOpacity": {
                "value": 0.9
              }
            },

            "hover": {
              "fillOpacity": {
                "value": 1
              }
            }
          }
        },

        {
          "type": "text",

          "from": {
            "data": "birdLeaves"
          },

          "interactive": false,

          "encode": {
            "enter": {
              "x": {
                "signal": "datum.x0 + 7"
              },
              "y": {
                "signal": "datum.y0 + headerHeight + 7"
              },
              "text": {
                "field": "family"
              },
              "font": {
                "value": "Source Sans 3"
              },
              "fontSize": {
                "value": 11.5
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "signal": "datum.family_type === 'Other' ? '#202622' : '#FFFFFF'"
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "top"
              },
              "limit": {
                "signal": "max(0, datum.x1 - datum.x0 - 12)"
              },
              "opacity": {
                "signal": "(datum.x1 - datum.x0) > 75 && (datum.y1 - datum.y0) > 28 ? 1 : 0"
              }
            }
          }
        },

        {
          "type": "text",

          "from": {
            "data": "birdLeaves"
          },

          "interactive": false,

          "encode": {
            "enter": {
              "x": {
                "signal": "datum.x0 + 7"
              },
              "y": {
                "signal": "datum.y0 + headerHeight + 24"
              },
              "text": {
                "signal": "format(datum.species_richness, ',') + ' species'"
              },
              "font": {
                "value": "Source Sans 3"
              },
              "fontSize": {
                "value": 10
              },
              "fill": {
                "signal": "datum.family_type === 'Other' ? '#202622' : '#FFFFFF'"
