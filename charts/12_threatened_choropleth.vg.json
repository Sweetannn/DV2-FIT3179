{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 510,
  "padding": 5,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "#f2f8fc",
  "params": [
    {
      "name": "map_centre",
      "value": "Melbourne",
      "bind": {
        "input": "select",
        "options": [
          "Melbourne",
          "Sydney",
          "Brisbane",
          "Adelaide",
          "Perth",
          "Hobart",
          "Darwin",
          "Canberra–Queanbeyan"
        ],
        "labels": [
          "Melbourne",
          "Sydney",
          "Brisbane",
          "Adelaide",
          "Perth",
          "Hobart",
          "Darwin",
          "Canberra–Queanbeyan"
        ],
        "name": "Choose a city: "
      }
    },
    {
      "name": "zoom_level",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 0.75,
        "max": 1.5,
        "step": 0.05,
        "name": "Map zoom: "
      }
    },
    {
      "name": "target_center",
      "expr": "map_centre === 'Sydney' ? [150.9, -33.849] : map_centre === 'Melbourne' ? [145.01, -37.971] : map_centre === 'Brisbane' ? [153.05, -27.383] : map_centre === 'Adelaide' ? [138.5, -34.999] : map_centre === 'Perth' ? [115.7, -32.124] : map_centre === 'Hobart' ? [147.35, -42.845] : map_centre === 'Darwin' ? [130.95, -12.428] : [149.114, -35.309]"
    },
    {
      "name": "target_scale",
      "expr": "map_centre === 'Sydney' ? 28875 : map_centre === 'Melbourne' ? 25800 : map_centre === 'Brisbane' ? 34375 : map_centre === 'Adelaide' ? 64125 : map_centre === 'Perth' ? 28500 : map_centre === 'Hobart' ? 60562.5 : map_centre === 'Darwin' ? 82500 : 76050"
    },
    {
      "name": "effective_center",
      "expr": "target_center"
    },
    {
      "name": "effective_scale",
      "expr": "target_scale * zoom_level * (width / 960)"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "center": {
      "expr": "effective_center"
    },
    "scale": {
      "expr": "effective_scale"
    }
  },
  "layer": [
    {
      "name": "regionalContext",
      "data": {
        "url": "geo/final/australia_lga_context.topojson",
        "format": {
          "type": "topojson",
          "feature": "regional_lgas"
        }
      },
      "transform": [
        {
          "filter": "indexof(datum.properties.contextCities, map_centre) >= 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#d4d6d4",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "clip": true
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.LGA_NAME21",
            "type": "nominal",
            "title": "Local government area"
          },
          {
            "value": "Outside the studied urban area",
            "title": "Study coverage"
          }
        ]
      }
    },
    {
      "name": "studiedUrbanLGAs",
      "data": {
        "url": "geo/final/city_lga_final.topojson",
        "format": {
          "type": "topojson",
          "feature": "city_lga_clipped"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.CITY === map_centre"
        },
        {
          "lookup": "properties.LGA_CODE21",
          "from": {
            "data": {
              "url": "data/final/13_threatened_lga_summary.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "CITY": "string",
                  "LGA_CODE21": "string",
                  "total_species": "number",
                  "threatened_species": "number",
                  "threatened_pct": "number"
                }
              }
            },
            "key": "LGA_CODE21",
            "fields": [
              "total_species",
              "threatened_species",
              "threatened_pct",
              "CITY"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "threatened_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [0.5, 1, 1.5, 2],
            "range": ["#fee5d9", "#fcbba1", "#fc9272", "#ef3b2c", "#99000d"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.CITY",
            "title": "Urban area",
            "type": "nominal"
          },
          {
            "field": "properties.LGA_NAME21",
            "title": "Local government area",
            "type": "nominal"
          },
          {
            "field": "total_species",
            "title": "Distinct recorded species",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "threatened_species",
            "title": "Nationally threatened species",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "threatened_pct",
            "title": "Nationally threatened species (%)",
            "type": "quantitative",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3"
  }
}
